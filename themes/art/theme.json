{
  "name": "Art",
  "group": "Subjects",
  "fonts": {
    "body": "\"Nunito\",system-ui,sans-serif",
    "headings": "\"Permanent Marker\",\"Caveat\",cursive"
  },
  "shape": {
    "radius": "20px",
    "smallRadius": "12px",
    "borderWidth": "1px",
