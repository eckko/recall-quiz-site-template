      "accent2": "#58c8e0",
      "highlight": "#f3d673",
      "correct": "#6fdca6",
      "wrong": "#ff8f9f",
      "partly": "#f0c15a",
      "pop1": "#ff8070",
      "pop2": "#58c8e0",
      "pop3": "#ffd24d",
      "pop4": "#b9a0f5",
      "onAccent": "#10141a",
      "onHero": "#10141a"
    },
    "background": [
      "radial-gradient(rgba(255,210,77,.12) 5px,transparent 6px) 0 0/90px 90px fixed",
      "linear-gradient(#101a30,#101a30) fixed"
