{
  "name": "Exercise",
  "group": "Wellbeing & culture",
  "fonts": {
    "body": "\"Barlow\",\"Inter\",system-ui,sans-serif",
    "headings": "\"Barlow Condensed\",\"Barlow\",system-ui,sans-serif"
  },
  "shape": {
    "radius": "8px",
    "smallRadius": "5px",
    "borderWidth": "1px",
    "strongBorderWidth": "2px"
  },
  "iconStroke": {
    "width": 3,
    "cap": "round",
    "join": "round"
  },
  "light": {
    "colors": {
      "page": "#fff2ea",
      "card": "#ffffff",
      "text": "#1c1917",
      "textMuted": "#6b5f58",
      "border": "#f2d5c4",
      "accent": "#ea580c",
      "accent2": "#0f172a",
      "highlight": "#fde047",
      "correct": "#1e7f5c",
      "wrong": "#c8402f",
      "partly": "#a15f00",
      "pop1": "#ea580c",
      "pop2": "#16a34a",
      "pop3": "#2563eb",
      "pop4": "#dc2626",
      "onAccent": "#ffffff",
      "onHero": "#ffffff"
    },
    "background": [
      "url(background-light.svg) 0 0/120px 120px fixed",
      "linear-gradient(160deg,#fff5ee,#ffe3d1) fixed"
    ]
  },
  "dark": {
    "colors": {
      "page": "#14110f",
      "card": "#201b18",
      "text": "#f7efe8",
      "textMuted": "#bcaea4",
      "border": "#3d3530",
      "accent": "#ff8a3d",
      "accent2": "#fbbf24",
      "highlight": "#ffe14d",
      "correct": "#5fd6a4",
      "wrong": "#ff8a7a",
      "partly": "#eab64a",
      "pop1": "#ff8a3d",
      "pop2": "#4ade80",
      "pop3": "#60a5fa",
      "pop4": "#ff6b6b",
      "onAccent": "#101418",
      "onHero": "#101418"
    },
    "background": [
      "url(background-dark.svg) 0 0/120px 120px fixed",
      "linear-gradient(160deg,#171210,#0f0c0b) fixed"
    ]
  }
}
