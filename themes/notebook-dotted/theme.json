{
  "name": "Notebook: Dotted",
  "group": "Classroom",
  "fonts": {
    "body": "\"Lexend\",\"Segoe UI\",system-ui,sans-serif",
    "headings": "\"Patrick Hand\",\"Lexend\",system-ui,sans-serif"
  },
  "shape": {
    "radius": "10px",
    "smallRadius": "6px",
    "borderWidth": "1px",
    "strongBorderWidth": "2px"
  },
  "iconStroke": {
    "width": 3,
    "cap": "round",
    "join": "round"
  },
  "light": {
    "colors": {
      "page": "#faf7f1",
      "card": "#ffffff",
      "text": "#2b2a28",
      "textMuted": "#625f59",
      "border": "#d9d3c7",
      "accent": "#2f6f68",
      "accent2": "#3a807a",
      "highlight": "#fde68a",
      "correct": "#1b7a4b",
      "wrong": "#b5364a",
      "partly": "#8a5a00",
      "pop1": "#2f6f68",
      "pop2": "#b4532a",
      "pop3": "#6a4aa8",
      "pop4": "#8a6a1f",
      "onAccent": "#ffffff",
      "onHero": "#ffffff"
    },
    "background": [
      "radial-gradient(rgba(90,84,70,.38) 1.4px,transparent 1.6px) 0 0/26px 26px fixed",
      "linear-gradient(#faf7f1,#faf7f1) fixed"
    ]
  },
  "dark": {
    "colors": {
      "page": "#191a1a",
      "card": "#222323",
      "text": "#ebe8e1",
      "textMuted": "#aeaaa1",
      "border": "#3b3d3c",
      "accent": "#6fcfc4",
      "accent2": "#8fe0d6",
      "highlight": "#f3d673",
      "correct": "#6fdca6",
      "wrong": "#ff8f9f",
      "partly": "#f0c15a",
      "pop1": "#6fcfc4",
      "pop2": "#f09a70",
      "pop3": "#b9a2f0",
      "pop4": "#e0c070",
      "onAccent": "#10141a",
      "onHero": "#10141a"
    },
    "background": [
      "radial-gradient(rgba(235,232,225,.22) 1.4px,transparent 1.6px) 0 0/26px 26px fixed",
      "linear-gradient(#191a1a,#191a1a) fixed"
    ]
  }
}
