      "highlight": "#fde68a",
      "correct": "#1b7a4b",
      "wrong": "#b5364a",
      "partly": "#8a5a00",
      "pop1": "#1f5fd6",
      "pop2": "#0b7a75",
      "pop3": "#b45309",
      "pop4": "#7c3aed",
      "onAccent": "#ffffff",
      "onHero": "#ffffff"
