      "pop2": "#58cdc6",
      "pop3": "#f5a35c",
      "pop4": "#b9a0f5",
      "onAccent": "#10141a",
      "onHero": "#10141a"
    },
    "background": [
      "linear-gradient(#12161c,#12161c) fixed"
    ]
