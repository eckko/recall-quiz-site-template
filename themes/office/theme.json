{
  "name": "Office",
  "group": "Professional",
  "fonts": {
    "body": "\"Inter\",\"Segoe UI\",system-ui,sans-serif",
    "headings": "\"Inter\",\"Segoe UI\",system-ui,sans-serif"
  },
  "shape": {
    "radius": "8px",
    "smallRadius": "6px",
    "borderWidth": "1px",
    "strongBorderWidth": "2px"
  },
  "iconStroke": {
    "width": 3,
    "cap": "round",
    "join": "round"
  },
  "light": {
    "colors": {
      "page": "#eef1f5",
      "card": "#ffffff",
      "text": "#1a2230",
      "textMuted": "#566170",
      "border": "#d3d9e2",
