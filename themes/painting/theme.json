{
  "name": "Painting",
  "group": "Art & music",
  "fonts": {
    "body": "\"Nunito\",\"Quicksand\",system-ui,sans-serif",
    "headings": "\"Caveat\",\"Patrick Hand\",cursive"
  },
  "shape": {
    "radius": "26px",
    "smallRadius": "14px",
    "borderWidth": "2px",
    "strongBorderWidth": "3px"
  },
  "iconStroke": {
    "width": 3.2,
    "cap": "round",
    "join": "round"
  },
  "light": {
    "colors": {
      "page": "#fff7ee",
      "card": "#fffdf9",
      "text": "#2b1d3a",
      "textMuted": "#6a5578",
      "border": "#f1d9c4",
      "accent": "#c2185b",
      "accent2": "#2563eb",
      "highlight": "#ffe27a",
      "correct": "#1e7f5c",
      "wrong": "#c8402f",
      "partly": "#a15f00",
      "pop1": "#f43f5e",
      "pop2": "#0d9488",
      "pop3": "#7c3aed",
      "pop4": "#ea580c",
      "onAccent": "#ffffff",
