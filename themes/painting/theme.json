      "partly": "#eab64a",
      "pop1": "#ff7a8e",
      "pop2": "#4fd6c4",
      "pop3": "#c79bff",
      "pop4": "#ffa24d",
      "onAccent": "#14110f",
      "onHero": "#14110f"
    },
    "background": [
      "url(background-dark.svg) 0 0/120px 120px fixed",
      "linear-gradient(160deg,#1c1328,#130c1d) fixed"
    ]
