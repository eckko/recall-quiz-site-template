{
  "name": "Pastel",
  "group": "Playful",
  "fonts": {
    "body": "\"Quicksand\",\"Nunito\",system-ui,sans-serif",
    "headings": "\"Quicksand\",\"Nunito\",system-ui,sans-serif"
  },
  "shape": {
    "radius": "24px",
    "smallRadius": "16px",
    "borderWidth": "1px",
    "strongBorderWidth": "2px"
  },
  "iconStroke": {
    "width": 3.2,
    "cap": "round",
    "join": "round"
  },
  "light": {
    "colors": {
      "page": "#fdf6fb",
      "card": "#ffffff",
      "text": "#3d3555",
      "textMuted": "#7b7394",
      "border": "#eadcf2",
      "accent": "#a78bfa",
      "accent2": "#f9a8d4",
      "highlight": "#fde68a",
      "correct": "#2f9e77",
      "wrong": "#e0527f",
      "partly": "#a97c0a",
      "pop1": "#f9a8d4",
      "pop2": "#99e2d0",
      "pop3": "#c4b5fd",
      "pop4": "#ffd08a",
      "onAccent": "#2d2547",
      "onHero": "#3d3555"
    },
    "background": [
      "url(background-light.svg) 0 0/220px 220px fixed",
      "linear-gradient(160deg,#fff0f8,#f3eeff 55%,#e9f7ff) fixed"
    ],
    "buttonShadow": [
      "0 5px 0 #7d63d6"
    ],
    "buttonShadowPressed": [
      "0 1px 0 #7d63d6"
    ],
