  "dark": {
    "colors": {
      "page": "#231d33",
      "card": "#2e2745",
      "text": "#f3eefc",
      "textMuted": "#b9afd3",
      "border": "#433a63",
      "accent": "#b79cff",
      "accent2": "#f7a9d6",
      "highlight": "#f3d673",
      "correct": "#7fe0b8",
      "wrong": "#ff8fb8",
      "partly": "#f0c15a",
      "pop1": "#f7a9d6",
      "pop2": "#86dcc9",
      "pop3": "#b9a8ff",
      "pop4": "#ffcf8b",
      "onAccent": "#231d33",
      "onHero": "#231d33"
    },
    "background": [
      "url(background-dark.svg) 0 0/220px 220px fixed",
      "linear-gradient(160deg,#2a2342,#231d33 60%,#2d2140) fixed"
    ],
    "buttonShadow": [
      "0 5px 0 #6a50c2"
    ],
