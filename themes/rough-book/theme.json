      "accent": "#a9bbe0",
      "accent2": "#c4d0ee",
      "highlight": "#f3d673",
      "correct": "#6fdca6",
      "wrong": "#ff8f9f",
      "partly": "#f0c15a",
      "pop1": "#a9bbe0",
      "pop2": "#f09a8a",
      "pop3": "#86c99a",
      "pop4": "#e0c070",
      "onAccent": "#10141a",
      "onHero": "#10141a"
    },
    "background": [
      "repeating-linear-gradient(180deg,transparent 0 35px,rgba(255,255,255,.07) 35px 36px) 0 0/100% 100% fixed",
      "linear-gradient(#1c1c1a,#1c1c1a) fixed"
    ]
