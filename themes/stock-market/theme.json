{
  "name": "Stock market",
  "group": "Finance",
  "fonts": {
    "body": "\"Barlow\",\"Inter\",system-ui,sans-serif",
    "headings": "\"Barlow Condensed\",\"Barlow\",system-ui,sans-serif"
  },
  "shape": {
    "radius": "10px",
    "smallRadius": "6px",
    "borderWidth": "2px",
