{
  "name": "Watercolor",
  "group": "Playful",
  "fonts": {
    "body": "\"Nunito\",system-ui,sans-serif",
    "headings": "\"Caveat\",\"Nunito\",cursive"
  },
  "shape": {
    "radius": "22px",
    "smallRadius": "14px",
    "borderWidth": "1px",
    "strongBorderWidth": "2px"
  },
  "iconStroke": {
    "width": 3.2,
    "cap": "round",
    "join": "round"
  },
  "light": {
    "colors": {
      "page": "#fbfaf6",
      "card": "#fffefb",
      "text": "#2f3a45",
      "textMuted": "#6b7886",
      "border": "#dfe6ec",
      "accent": "#3f7fb0",
      "accent2": "#6fae95",
      "highlight": "#f7e08a",
      "correct": "#3f8f6c",
      "wrong": "#c85a5a",
      "partly": "#a8741a",
      "pop1": "#e58a9b",
      "pop2": "#6bb7a4",
      "pop3": "#7f9de0",
      "pop4": "#eab45f",
      "onAccent": "#ffffff",
      "onHero": "#ffffff"
    },
    "background": [
      "url(background-light.svg) center/cover no-repeat fixed",
      "var(--color-page)"
    ],
    "buttonShadow": [
      "0 8px 18px -8px rgba(63,127,176,.7)"
    ],
    "buttonShadowPressed": [
      "0 2px 6px -2px rgba(63,127,176,.6)"
    ],
    "panelShadow": [
      "0 14px 34px -18px rgba(63,127,176,.5)"
    ],
    "pressDepth": "2px"
  },
  "dark": {
    "colors": {
      "page": "#151c24",
      "card": "#1d2732",
      "text": "#e8eef4",
      "textMuted": "#a2b1c0",
      "border": "#2f3d4c",
      "accent": "#7db4e0",
      "accent2": "#9ad1b8",
      "highlight": "#e7cf73",
      "correct": "#6fd0a5",
      "wrong": "#f09090",
      "partly": "#e6b04d",
      "pop1": "#f0a0b0",
      "pop2": "#86d3c0",
      "pop3": "#9fb4f0",
      "pop4": "#f2c47a",
      "onAccent": "#10202c",
      "onHero": "#10202c"
    },
    "background": [
      "url(background-dark.svg) center/cover no-repeat fixed",
      "var(--color-page)"
    ],
    "buttonShadow": [
      "0 8px 18px -8px rgba(0,0,0,.7)"
    ],
    "buttonShadowPressed": [
      "0 2px 6px -2px rgba(0,0,0,.6)"
    ],
    "panelShadow": [
      "0 14px 34px -18px rgba(0,0,0,.6)"
    ],
    "pressDepth": "2px"
  }
}
